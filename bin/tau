#!/usr/bin/env bash
set -euo pipefail

code_home="${TAU_LOOP_CODEX_HOME:-${HOME}/.codex}"
asset_root="${code_home}/skills/tau-loop/assets"

usage() {
  cat <<'EOF'
Usage: tau init [options]

Commands:
  init       Bootstrap the TauLoop skeleton in a project: AGENTS.md plus
             .harness/ (spec templates, hooks, check scripts, verification
             profiles). Creates only missing files, never overwrites existing
             user files; refreshes unmodified managed tools.

TauLoop has exactly one command. Everything else is convention documented in
the project's AGENTS.md. To uninstall TauLoop, run: python3 install.py --uninstall
EOF
}

require_assets() {
  if [[ ! -f "${asset_root}/tools/project_lifecycle.py" ]]; then
    printf 'TauLoop is not installed correctly. Re-run install.py.\n' >&2
    exit 1
  fi
}

command="${1:-}"
case "${command}" in
  init)
    require_assets
    shift
    exec python3 "${asset_root}/tools/project_lifecycle.py" init "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "${command}" >&2
    usage >&2
    exit 1
    ;;
esac
