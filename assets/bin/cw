#!/usr/bin/env bash
set -euo pipefail

ROOT=""
ROOT_SUPPLIED=0
ARGS=("$@")
for ((i = 0; i < ${#ARGS[@]}; i++)); do
  if [[ "${ARGS[$i]}" == "--root" ]]; then
    next_index=$((i + 1))
    ROOT="${ARGS[$next_index]:-}"
    ROOT_SUPPLIED=1
    break
  fi
done

if [[ -z "$ROOT" ]]; then
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi

case "${1:-}" in
loop|loop-status|loop-recover|loop-cancel)
  SCRIPT="$ROOT/.codex/tools/cw_agent_loop.py"
  if [[ ! -f "$SCRIPT" && "$ROOT_SUPPLIED" -eq 0 && "$#" -eq 2 ]]; then
    case "${2:-}" in
    -h|--help)
      PACKAGED_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/tools/cw_agent_loop.py"
      if [[ -f "$PACKAGED_SCRIPT" ]]; then
        exec python3 "$PACKAGED_SCRIPT" "$1" --help
      fi
      ;;
    esac
  fi
  if [[ ! -f "$SCRIPT" ]]; then
    printf 'Missing continuous-work v3 agent loop: %s\nRun tau init --root . in the repo first.\n' "$SCRIPT" >&2
    exit 1
  fi
  if [[ "$ROOT_SUPPLIED" -eq 0 ]]; then
    exec python3 "$SCRIPT" "$1" --root "$ROOT" "${@:2}"
  fi
  exec python3 "$SCRIPT" "$@"
  ;;
run|run-status|run-cancel|run-recover|handoff-create|handoff-launch|handoff-review)
  SCRIPT="$ROOT/.codex/tools/cw_supervisor.py"
  if [[ ! -f "$SCRIPT" ]]; then
    printf 'Missing continuous-work v2 supervisor: %s\nRun tau init --root . in the repo first.\n' "$SCRIPT" >&2
    exit 1
  fi
  if [[ "$ROOT_SUPPLIED" -eq 0 ]]; then
    exec python3 "$SCRIPT" "$1" --root "$ROOT" "${@:2}"
  fi
  exec python3 "$SCRIPT" "$@"
  ;;
esac

SCRIPT="$ROOT/.codex/tools/cw_state.py"
if [[ ! -f "$SCRIPT" ]]; then
  printf 'Missing continuous-work control plane: %s\nRun tau init --root . in the repo first.\n' "$SCRIPT" >&2
  exit 1
fi

exec python3 "$SCRIPT" "$@"
