#!/usr/bin/env bash
set -euo pipefail

ROOT=""
ROOT_SUPPLIED=0
ARGS=("$@")
for ((i = 0; i < ${#ARGS[@]}; i++)); do
  if [[ "${ARGS[$i]}" == "--root" ]]; then
    next_index=$((i + 1))
    ROOT="${ARGS[$next_index]:-}"
    ROOT_SUPPLIED=1
    break
  fi
done

if [[ -z "$ROOT" ]]; then
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi

case "${1:-}" in
loop|loop-status|loop-recover|loop-cancel)
  # v3 bounded loop is deprecated and archived (2026-08-06, owner decision).
  # Help stays available; any actual execution is blocked so agents only run
  # the current agent-led path (tau agent-run / cw agent-run).
  SHOW_HELP=0
  for ((help_i = 1; help_i < ${#ARGS[@]}; help_i++)); do
    if [[ "${ARGS[$help_i]}" == "-h" || "${ARGS[$help_i]}" == "--help" ]]; then
      SHOW_HELP=1
      break
    fi
  done
  if [[ "$SHOW_HELP" -eq 1 ]]; then
    cat <<'EOF'
deprecated: `cw loop` (continuous-work v3 bounded agent loop) 已归档并标记 deprecated。
agent-led continuous-work 已取代 v3 作为主路径。

请使用：
  tau agent-run --dry-run   # 本机：自动闭环（唤醒动作仅打印决策，不调 agent）
  tau agent-run             # 真实：resume 主导 agent 修复并重跑
EOF
    exit 0
  fi
  printf 'deprecated: `%s` (v3 bounded loop) 已归档并标记 deprecated；agent 执行只走 agent-run 路径。\n' "$1" >&2
  printf '请使用 `tau agent-run --dry-run`（本机）/ `tau agent-run`（真机）。\n' >&2
  exit 2
  ;;
run|run-status|run-cancel|run-recover|handoff-create|handoff-launch|handoff-review)
  SCRIPT="$ROOT/.codex/tools/cw_supervisor.py"
  if [[ ! -f "$SCRIPT" ]]; then
    printf 'Missing continuous-work v2 supervisor: %s\nRun tau init --root . in the repo first.\n' "$SCRIPT" >&2
    exit 1
  fi
  if [[ "$ROOT_SUPPLIED" -eq 0 ]]; then
    exec python3 "$SCRIPT" "$1" --root "$ROOT" "${@:2}"
  fi
  exec python3 "$SCRIPT" "$@"
  ;;
agent-run|agent-session|agent-events|agent-exec|agent-guard)
  case "$1" in
    agent-run)       ASCRIPT="cw_agent_runner.py" ;;
    agent-session)   ASCRIPT="cw_agent_session.py" ;;
    agent-events)    ASCRIPT="cw_agent_events.py" ;;
    agent-exec)      ASCRIPT="cw_agent_executor.py" ;;
    agent-guard)     ASCRIPT="cw_agent_guardrails.py" ;;
  esac
  SCRIPT="$ROOT/.codex/tools/$ASCRIPT"
  if [[ ! -f "$SCRIPT" && "$ROOT_SUPPLIED" -eq 0 && "$#" -eq 2 ]]; then
    case "${2:-}" in
    -h|--help)
      PACKAGED_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/tools/$ASCRIPT"
      if [[ ! -f "$PACKAGED_SCRIPT" ]]; then
        PACKAGED_SCRIPT="${HOME}/.codex/skills/tau-loop/assets/tools/$ASCRIPT"
      fi
      if [[ -f "$PACKAGED_SCRIPT" ]]; then
        exec python3 "$PACKAGED_SCRIPT" --help
      fi
      ;;
    esac
  fi
  if [[ ! -f "$SCRIPT" ]]; then
    printf 'Missing agent-led tool: %s\nRun tau init --root . in the repo first.\n' "$SCRIPT" >&2
    exit 1
  fi
  # agent-* tools take --root as a top-level option (before the subcommand);
  # strip any user-supplied --root and normalize it to the front.
  STRIP_ARGS=()
  SKIP_NEXT=0
  for ((i = 1; i < ${#ARGS[@]}; i++)); do
    if [[ "$SKIP_NEXT" -eq 1 ]]; then
      SKIP_NEXT=0
      continue
    fi
    if [[ "${ARGS[$i]}" == "--root" ]]; then
      SKIP_NEXT=1
      continue
    fi
    STRIP_ARGS+=("${ARGS[$i]}")
  done
  exec python3 "$SCRIPT" --root "$ROOT" "${STRIP_ARGS[@]}"
  ;;
esac

SCRIPT="$ROOT/.codex/tools/cw_state.py"
if [[ ! -f "$SCRIPT" ]]; then
  printf 'Missing continuous-work control plane: %s\nRun tau init --root . in the repo first.\n' "$SCRIPT" >&2
  exit 1
fi

exec python3 "$SCRIPT" "$@"
